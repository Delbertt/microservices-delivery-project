# .env.local

# PostgreSQL
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=dba@deliveryproj.com
PGADMIN_DEFAULT_PASSWORD=deliveryproj123
PGADMIN_PORT=8083

# Kafka
KAFKA_NODE_ID=0
KAFKA_PROCESS_ROLES=controller,broker
KAFKA_LISTENERS=PLAINTEXT://:9090,CONTROLLER://:9091,EXTERNAL://:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9090,EXTERNAL://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=0@kafka:9091
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_EXTERNAL_PORT=9092

# Kafka UI
KAFKA_CLUSTER_NAME=projdelivery-kafka-cluster
KAFKA_BOOTSTRAP_SERVERS=kafka:9090
KAFKA_UI_PORT=8084